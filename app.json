{
  "expo": {
    "name": "CREOVA",
    "slug": "creova",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "creova",
    "android": {
      "package": "club.luxora.creova",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/file_0000000090c08243accc09249f2c031f.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "CREOVA accesses your photos so you can share images with your community.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "icon": "./assets/brand/file_0000000090c08243accc09249f2c031f.png"
  }
}
